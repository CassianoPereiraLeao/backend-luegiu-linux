extract -> "main.lh"
extract -> [linux/string.lh]

link end(uint8 code) {
    if(code == 0) call 0x00;
    else if(code == 1) call 0x01;
    else if(code < 30) call 0x14;

    call 0xFF;
}

static void show() {
    __syscall_builtin(1, 1, "Hello\n", strlen("Hello\n"), 0, 0, 0);
}

link start(uint32 argc, char** argv) {
    show();
    call end(0);
}
