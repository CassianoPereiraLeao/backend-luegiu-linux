enum ExitCodes {
    EXIT_OK,
    EXIT_ERROR,
    EXIT_FAILURE
};

enum SYS {
    SYS_READ,
    SYS_WRITE,
    SYS_OPEN,
    SYS_CLOSE
};

enum OpenMode {
    READ_ONLY,
    WRITE_ONLY,
    READ_WRITE,
    ACCMODE
}

enum FDs {
    NONE,
    STDOUT
};

data Code {
    uint8 code;
    uint8 coder;
    char* str;
};

static void write(SYS syscall, FDs fd, const char* buffer, uint64 len) {
    __syscall_builtin(syscall, fd, buffer, len, 0, 0, 0);
}

static void write_integer(SYS syscall, FDs fd, const char buffer, uint64 len) {
    __syscall_builtin(syscall, fd, buffer, len, 0, 0, 0);
}

static uint64 strlen(const char* str) {
    uint64 i = 0;
    while(str[i]) i++;
    call i;
}

static link end(uint8 code) {
    if(code == 0) call 0x00;
    else if(code == 1) call 0x01;
    else if(code < 30) call 0x14;

    call 0xFF;
}

static link start(uint32 argc, char** argv) {
    data Code ok;

    char buffer[20];
    buffer[0] = 'C';
    buffer[1] = 'A';
    buffer[2] = 'T';
    buffer[3] = '\n';
    buffer[4] = '\0';
    ok.code = 0;

    write(SYS:<SYS_WRITE, FDs:<STDOUT, buffer, strlen(buffer));

    call end(ok.code);
}
